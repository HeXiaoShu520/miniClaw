# 日志级别
LOG_LEVEL=info

# 是否使用话题回复
USE_TOPIC_REPLY=false

# 是否使用流式回复
USE_STREAM=false

# 飞书配置
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# AI 提供商（anthropic 或 openai）
AI_PROVIDER=anthropic

# Claude 配置（AI_PROVIDER=anthropic 时使用）
CLAUDE_API_KEY=sk-ant-xxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_BASE_URL=

# OpenAI 配置（AI_PROVIDER=openai 时使用）
OPENAI_API_KEY=sk-xxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# 腾讯云 TTS 配置（tts_reply 技能使用，可选）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TTS_MAX_LENGTH=150

# 豆包搜索 Custom 版 API Key（doubao_search 技能使用，可选）
DOUBAO_SEARCH_API_KEY=

# 记住的历史消息轮数
MAX_HISTORY_TURNS=10

# AI 角色系统提示词
SYSTEM_PROMPT=你是一个聪明、高效的 AI 助手。请直接回答用户的问题，不要说废话。

# 表情回应列表（逗号分隔，收到消息时随机选一个）
EMOJI_TYPES=THUMBSUP,HEART,APPLAUSE,SMILE,LOVE,THANKS,OK,ROSE,PARTY,MUSCLE,FINGERHEART,DONE,LAUGH,WINK,PROUD,EYES,ROCKET,STAR,FIRE,CELEBRATE,PRAY,HANDSHAKE,GIFT,COFFEE,BEER,CAKE,BALLOON,TROPHY,MEDAL,CROWN

# 管理员 open_id（机器人上线/下线时发通知）
ADMIN_OPEN_ID=

# 上线/下线通知文字（留空则不发送）
ADMIN_ONLINE_MSG=✅ 机器人已上线
ADMIN_OFFLINE_MSG=⚠️ 机器人已下线
