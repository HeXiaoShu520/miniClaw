# 日志级别
LOG_LEVEL=info

# 是否使用话题回复
USE_TOPIC_REPLY=false

# 是否使用流式回复
USE_STREAM=false

# 飞书配置
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# AI 提供商（anthropic 或 openai）
AI_PROVIDER=anthropic

# Claude 配置（AI_PROVIDER=anthropic 时使用）
CLAUDE_API_KEY=sk-ant-xxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_BASE_URL=

# OpenAI 配置（AI_PROVIDER=openai 时使用）
OPENAI_API_KEY=sk-xxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# 腾讯云 TTS 配置（tts_reply 技能使用，可选）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TTS_MAX_LENGTH=150

# 记住的历史消息轮数
MAX_HISTORY_TURNS=10

# AI 角色系统提示词
SYSTEM_PROMPT=你是一个聪明、高效的 AI 助手。请直接回答用户的问题，不要说废话。
